{
  "permissions": {
    "allow": [
      "Bash(.venv/Scripts/python:*)",
      "Bash(.venv/Scripts/python.exe:*)",
      "Bash(.venv/Scripts/pytest:*)",
      "Bash(.venv/Scripts/ruff:*)",
      "Bash(python:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Read(./**)",
      "Edit(./src/**)",
      "Edit(./tests/**)",
      "Edit(./scripts/**)",
      "Edit(./docs/**)"
    ],
    "ask": [
      "Bash(pip install:*)",
      "Bash(.venv/Scripts/python -m pip install:*)",
      "Bash(git push:*)",
      "Edit(./requirements.txt)",
      "Edit(./CLAUDE.md)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(rm -rf:*)",
      "Bash(git reset --hard:*)",
      "Bash(git push --force:*)"
    ]
  }
}
